# MySQL
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=mead
MYSQL_USER=mead
MYSQL_PASSWORD=meadpassword

# Host port MySQL is published on (defaults to 3307, not 3306, in case
# you already have a local MySQL install using the standard port).
MYSQL_HOST_PORT=3307

# Server (DATABASE_URL host is "mysql" — the compose service name, used
# for container-to-container traffic and always port 3306 internally.
# If running Prisma CLI from your host machine instead of inside the
# container, swap the host to "localhost" and the port to MYSQL_HOST_PORT.)
DATABASE_URL="mysql://mead:meadpassword@mysql:3306/mead"
SESSION_SECRET=changeme
SERVER_PORT=4000

# Used by the session store (express-mysql-session), which connects to
# MySQL directly rather than through Prisma. Internal traffic only, so
# host/port are fixed regardless of MYSQL_HOST_PORT above.
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Must match the client's actual origin — cookies won't be set/sent
# cross-origin without an exact match here (no wildcard with credentials).
CLIENT_ORIGIN=http://localhost:3000

# Client
CLIENT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
